{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volei VidIA",
  "version": "0.10.2",
  "identifier": "cat.voleividia.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Volei VidIA",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Sports",
    "shortDescription": "Estadístiques de voleibol amb vídeo",
    "longDescription": "Codificació de partits de voleibol compatible amb DataVolley, amb vídeo sincronitzat i estadístiques.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["Catalan", "Spanish", "English"] }
    }
  }
}
